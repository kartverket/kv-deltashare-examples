    %%%%%%%%%%%% Dimensjonstabeller %%%%%%%%%%%%

    dim_matrikkelenhet{
        bigint matrikkelenhetId PK
        bigint gaardsnummer
        bigint bruksnummer
        bigint festenummer
        bigint seksjonsnummer
        bigint zk_kommuneId
    }

   dim_kommuner_matrikkel{
        bigint kommuneId PK
        string kommunenummer
    }

    dim_kommuner_grunnbok{
        bigint kommuneId PK
        string kommunenummer
    }

    %% Juridisk person er tegnet opp med forenklede kolonnenavn
    dim_juridisk_person{
        bigint juridiskPersonId PK
        string nummer
    }

    dim_fysisk_person{
        bigint fysiskPersonId PK
    }

    dim_annen_person{
        bigint fysiskPersonId PK
    }

    dim_registerenhet{
        bigint id PK
        boolean utgaatt
        bigint gaardsnummer
        bigint bruksnummer
        bigint festenummer
        bigint seksjonsnummer
        bigint zk_borettslag
        bigint andelsnummer
        bigint zk_kommuneId
    }
