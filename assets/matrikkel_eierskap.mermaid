    %%%%%%%%%%%% Faktatabeller %%%%%%%%%%%%

    fact_eierforhold{
        bigint eierforholdId PK
        bigint zk_matrikkelenhetId FK
        bigint zk_eiendeMatrikkelenhetId FK
        bigint zk_eierId FK
        bigint zk_eierforholdKodeId FK
        bigint zk_kommuneId FK
    }

    fact_matrikkelenhet{
        bigint matrikkelenhetId PK
        bigint zk_historiskArealkildeId FK
        bigint zk_kommuneId FK
        array zk_teigerForMatrikkelenhet FK
    }

